# Model Provider Configuration (ollama, openai, anthropic, deepseek, gemini)
ACTIVE_PROVIDER=ollama
MODEL_NAME=gemma-4-31b-it

# Dual-model configuration (2026 recommended)
# Use separate models for thinking (planning/reflection) and executing (action generation)
# THINK_MODEL=gemma-4-31b-it
# THINK_PROVIDER=ollama
# EXECUTE_MODEL=qwen3.6-27b
# EXECUTE_PROVIDER=ollama

# Ollama Configuration (Local/Remote)
OLLAMA_HOST=http://localhost:11434

# Anthropic API (Claude Opus 5, Claude Fable 5, Claude 3.7 Sonnet)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-5-latest

# OpenAI API (GPT-5.6 Sol, GPT-5.5, o3-mini)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-5.6-sol

# Google Gemini API (Gemini 3.1 Pro, Gemini 3.7 Flash, Gemma 4)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-pro

# DeepSeek API (DeepSeek-V4 Pro, DeepSeek-V4 Flash, DeepSeek-Reasoner)
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
