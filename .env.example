# Model Provider Configuration
ACTIVE_PROVIDER=ollama
MODEL_NAME=gemma4:latest

# Dual-model configuration (optional)
# Use separate models for thinking (planning/reflection) and executing (action generation)
# THINK_MODEL=qwen3.5:27b
# THINK_PROVIDER=ollama
# EXECUTE_MODEL=gemma4:12b
# EXECUTE_PROVIDER=ollama

# Ollama Configuration (Local/Remote)
OLLAMA_HOST=http://localhost:11434

# Ollama Cloud (optional - for cloud-hosted models)
# Get your API key from: https://ollama.com/cloud
# OLLAMA_API_KEY=your-ollama-cloud-key

# Alternative: Custom OpenAI-compatible endpoint (e.g., rsxermu666.cn)
# RSXERMU_BASE_URL=https://rsxermu666.cn
# RSXERMU_API_KEY=your-api-key
# RSXERMU_MODEL=gemma4:latest

# DeepSeek API (https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Benchmark API Keys
# Used by benchmark_deepseek_vs_mimo.py
BENCHMARK_DEEPSEEK_API_KEY=your-deepseek-api-key
BENCHMARK_MIMO_API_KEY=your-mimo-api-key
